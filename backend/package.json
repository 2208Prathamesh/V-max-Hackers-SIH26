{
  "name": "backend",
  "version": "1.0.0",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon --exec \"node --max-old-space-size=4096\" src/server.js",
    "seed": "node ../seed/index.js",
    "seed:clean": "node ../seed/index.js --clean",
    "seed:fresh": "node ../seed/index.js --fresh",
    "create-user": "node src/scripts/createUser.js",
    "user:create": "node src/scripts/createUser.js",
    "test": "node --max-old-space-size=4096 --test --test-concurrency=1 ../test/**/*.test.js",
    "test:unit": "node --test --test-concurrency=1 ../test/unit/*.test.js",
    "test:integration": "node --max-old-space-size=4096 --test --test-concurrency=1 ../test/integration/*.test.js",
    "test:system": "node --test --test-concurrency=1 ../test/system/*.test.js",
    "test:edge": "node --test --test-concurrency=1 ../test/edge-cases/*.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "description": "",
  "dependencies": {
    "@mattnucc/gribberish": "^1.7.0",
    "@weacast/grib2json": "^2.3.1",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "fast-xml-parser": "^5.11.1",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "joi": "^18.2.5",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.3",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.1",
    "react-i18next": "^17.0.13",
    "redis": "^6.2.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
