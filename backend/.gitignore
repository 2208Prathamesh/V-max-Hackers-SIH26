# ==============================================================================
# WeatherGPT Backend .gitignore
# ==============================================================================

# Dependencies
node_modules/
**/node_modules/

# Environment secrets
.env
.env.*
*.env
*.local
!.env.example

# Caches & Storage
.nwp_cache/
**/.nwp_cache/
.freebuff/
**/.freebuff/
mongodb_local_data/

# Logs & Debugging
logs/
*.log
npm-debug.log*

# Keys & Certificates
*.pem
*.key
*.cert
