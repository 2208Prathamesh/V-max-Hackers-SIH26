MONGO_URI=mongodb://localhost:27017/weathergpt
PORT=5000
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_SECRET_STRING
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173

# AI / LLM (optional — chat will return basic responses without it)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Official Meteorological APIs (optional)
IMD_API_KEY=
MOSDAC_API_KEY=

# Rate Limiting (optional — defaults to 100 requests per 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100