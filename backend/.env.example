# ==============================================================================
# WeatherGPT Backend Configuration Template (.env.example)
# ==============================================================================
# Copy this file to `.env` and supply your actual credentials.
# In production, ensure JWT_SECRET is unique and at least 32 characters long.
# ==============================================================================

# 1. CORE SERVER & DATABASE
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/weathergpt
FRONTEND_URL=http://localhost:5173

# 2. AUTHENTICATION & JWT SECURITY
# Generate a secure random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_SECRET_STRING_IN_PRODUCTION
JWT_EXPIRES_IN=7d
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# 3. AI / LLM ADVISORY (Optional — grounded convective fallback used if unset)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-1.5-flash

# 4. OFFICIAL METEOROLOGICAL APIs (Optional — Open-Meteo and IMD public feeds used by default)
IMD_API_KEY=your_imd_api_key
MOSDAC_API_KEY=your_mosdac_api_key

# 5. RATE LIMITING & SECURITY DEFENSES
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# 6. AUTOMATED WEATHER & CLIMATE NEWS CRAWLER
NEWS_INDIA_QUERY=India weather OR monsoon OR flood OR cyclone OR cloudburst OR IMD
NEWS_GLOBAL_QUERY=extreme weather OR cyclone OR hurricane OR typhoon OR heatwave OR flood disaster OR climate emergency
NEWS_TRENDING_TOPICS=monsoon,flood,cyclone,cloudburst,heatwave,hurricane,typhoon,landslide,drought,wildfire,storm

# 7. SMTP EMAIL NOTIFICATION SERVICE (Gmail, SendGrid, Amazon SES, Mailtrap)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
SMTP_FROM_NAME=WeatherGPT Security & Emergency Cell
SMTP_FROM_EMAIL=alerts@weathergpt.ai

# 8. REDIS HIGH-SPEED CACHE & NWP PERSISTENCE (Optional — memory fallback active if unavailable)
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_COORDINATE_PRECISION=2

# Redis Cache Freshness & Retention TTLs (in seconds)
REDIS_TTL_CURRENT_FRESH_S=600
REDIS_TTL_CURRENT_RETENTION_S=86400
REDIS_TTL_HOURLY_FRESH_S=1800
REDIS_TTL_HOURLY_RETENTION_S=1209600
REDIS_TTL_FORECAST_FRESH_S=3600
REDIS_TTL_FORECAST_RETENTION_S=2592000
REDIS_TTL_RUN_RETENTION_S=604800
REDIS_TTL_ALERTS_FRESH_S=600
REDIS_TTL_ALERTS_RETENTION_S=2592000

# 9. SOCIAL OAUTH LOGIN (Google, Microsoft, Apple)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
MICROSOFT_CLIENT_ID=your_microsoft_app_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
APPLE_CLIENT_ID=com.weathergpt.auth
APPLE_TEAM_ID=your_apple_team_id
