MONGO_URI=mongodb://localhost:27017/weathergpt
PORT=5000
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_SECRET_STRING
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173

# AI / LLM (optional — chat uses free grounded fallback if unset)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash

# Official Meteorological APIs (optional — free government / Open-Meteo feeds used by default)
IMD_API_KEY=your_imd_key
MOSDAC_API_KEY=your_mosdac_key

# Security & Rate Limiting
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
