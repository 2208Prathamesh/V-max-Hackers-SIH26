# ============================================================
# WeatherGPT Mobile — API configuration
# ============================================================
# Copy this file to `.env.local` and adjust for your environment.
# Values are read at bundle time — restart the Expo dev server
# after changing this file.
#
#   Android emulator:  http://10.0.2.2:5000/api
#   iOS simulator:     http://localhost:5000/api
#   Physical device:   http://<your-computer-LAN-IP>:5000/api
#   Production:        https://your-deployed-backend/api
#
# Example (physical device on the same Wi-Fi):
EXPO_PUBLIC_API_URL=http://192.168.1.100:5000/api