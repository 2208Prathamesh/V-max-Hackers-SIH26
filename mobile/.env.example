# ==============================================================================
# WeatherGPT Mobile (Expo) Configuration Template (.env.example)
# ==============================================================================
# Copy this file to `.env` or `.env.local` to override runtime endpoint resolution.
# Variables prefixed with EXPO_PUBLIC_ are injected at bundle time.
# Restart the Expo bundler (npm start) after modifying this file.
# ==============================================================================

# 1. Android Emulator (AVD):
# EXPO_PUBLIC_API_URL=http://10.0.2.2:5000/api

# 2. iOS Simulator:
# EXPO_PUBLIC_API_URL=http://localhost:5000/api

# 3. Physical Android / iOS Phone on Local Wi-Fi (replace with your machine's LAN IP):
# EXPO_PUBLIC_API_URL=http://192.168.0.102:5000/api

# 4. Web Browser Preview:
# EXPO_PUBLIC_API_URL=http://localhost:5000/api

# 5. Production Cloud Deployment:
# EXPO_PUBLIC_API_URL=https://api.weathergpt.ai/api

EXPO_PUBLIC_API_URL=http://localhost:5000/api