# ==============================================================================
# WeatherGPT Monorepo Global Environment Reference (.env.example)
# ==============================================================================
# WeatherGPT consists of three interoperable components:
#   1. Backend (Node.js/Express/MongoDB/Socket.IO) -> `backend/.env`
#   2. Frontend (Vite/React/TailwindCSS)           -> `frontend/.env`
#   3. Mobile (Expo/React Native/Hermes)           -> `mobile/.env`
#
# Refer to the individual service directories for specific template files:
#   - `backend/.env.example`
#   - `frontend/.env.example`
#   - `mobile/.env.example`
# ==============================================================================

# ------------------------------------------------------------------------------
# BACKEND (PORT 5000)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/weathergpt
JWT_SECRET=dev_secret_key_change_in_production_min_32_chars
FRONTEND_URL=http://localhost:5173

# Optional AI LLM & Weather Services
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
IMD_API_KEY=
MOSDAC_API_KEY=

# ------------------------------------------------------------------------------
# FRONTEND (PORT 5173)
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:5000/api

# ------------------------------------------------------------------------------
# MOBILE (PORT 8081 / Expo)
# ------------------------------------------------------------------------------
EXPO_PUBLIC_API_URL=http://localhost:5000/api
